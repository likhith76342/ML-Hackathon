# Raw / processed data (too large for git; see README)
data/raw/*
!data/raw/.gitkeep
# processed data is regenerated with `python -m pathsnap.build_dataset` (or copied from the team Drive)
data/processed/*
!data/processed/.gitkeep
!data/processed/folds.csv
!data/processed/trip_quality.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/

# Secrets / local config
.env
*.local.yaml

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large model files (commit only if < ~50 MB; remove the line below for small models)
results/**/model.joblib

